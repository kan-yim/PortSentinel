# Azure OpenAI API Configuration
# Required: Get these from your Azure OpenAI resource
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here

# Optional: Azure OpenAI API Version
# Default is 2024-02-15-preview if not specified
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Model Configuration
# AZURE_OPENAI_TEMPERATURE=0.0

# Optional: LangSmith Tracing (for debugging and monitoring)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=portsentinel-incident-parser
